---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Owners from '@/components/Owners.astro';
import JobNotes from '@/components/JobNotes.astro';
import QuoteSection from '@/components/QuoteSection.astro';
import supplies from '@/assets/img/supplies.jpg';
import { company } from '@/data/business';
---

<Base
  title={`About Us | ${company.name}`}
  description="Fortis K² Cleaning Solutions is owned and run by Kaleigh, McKayla and Sarah: three women, one family, cleaning homes across Brattleboro and Southern Vermont."
  breadcrumbs={[{ name: 'About', href: '/about/' }]}
>
  <section class="ab">
    <div class="wrap ab-grid">
      <div class="ab-copy">
        <p class="eyebrow">About Fortis K²</p>
        <h1>A family business you can let in the door.</h1>
        <p class="lede">
          Kaleigh, McKayla and Sarah started {company.shortName} with one goal: build a dependable, family-run business that takes some of the stress off your plate.
          Life gets busy, homes get lived in, businesses need upkeep, and sometimes there just are not enough hours in the day. That is where we come in.
        </p>
        <div class="maple-rule" aria-hidden="true"><img src="/brand/maple.png" alt="" width="26" height="26" /></div>
        <p class="ab-tag">{company.tagline}</p>
      </div>
      <div class="ab-media">
        <Image src={supplies} alt="Fortis K² cleaning supplies loaded into crates, ready for the next home" widths={[480, 800]} sizes="(max-width: 900px) 80vw, 38vw" loading="eager" />
      </div>
    </div>
  </section>

  <Owners full />
  <JobNotes />
  <QuoteSection />
</Base>

<style>
  .ab { padding-block: clamp(2.5rem, 6vw, 5rem); background: radial-gradient(60% 70% at 100% 0%, var(--blush) 0%, transparent 70%); }
  .ab-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .ab-copy { display: grid; gap: 1.3rem; justify-items: start; min-width: 0; }
  .ab-copy h1 { font-size: clamp(2.4rem, 5vw, 4.2rem); font-variation-settings: 'wdth' 70; }
  .ab-tag { font-weight: 800; font-size: 1.2rem; color: var(--navy); }
  .ab-media { position: relative; isolation: isolate; max-width: 420px; justify-self: end; }
  .ab-media::before { content: ''; position: absolute; inset: 16px -16px -16px 16px; border-radius: 200px 200px var(--r-card) var(--r-card); background: var(--pink); z-index: -1; }
  .ab-media :global(img) { border-radius: 200px 200px var(--r-card) var(--r-card); aspect-ratio: 3 / 4; object-fit: cover; box-shadow: var(--shadow-md); }
  @media (max-width: 900px) { .ab-grid { grid-template-columns: 1fr; } .ab-media { justify-self: center; margin-right: 16px; } }
</style>
