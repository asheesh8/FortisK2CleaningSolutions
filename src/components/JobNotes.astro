---
import { Image } from 'astro:assets';
import living from '@/assets/img/living-room-reset.jpg';
import supplies from '@/assets/img/supplies.jpg';
import { jobNotes, company } from '@/data/business';
---

<section class="section jobs" id="work">
  <div class="wrap jobs-grid">
    <div class="jobs-media" data-reveal>
      <figure class="jobs-main">
        <Image src={living} alt="A pine-walled living room during a Fortis K² whole-home reset" widths={[640, 960, 1280]} sizes="(max-width: 900px) 92vw, 50vw" />
      </figure>
      <figure class="jobs-side">
        <Image src={supplies} alt="Fortis K² cleaning supplies packed into crates and a bucket, ready for a job" widths={[320, 480]} sizes="(max-width: 900px) 40vw, 230px" />
      </figure>
    </div>

    <div class="jobs-copy">
      <h2 data-reveal>Recent work around {company.county}.</h2>
      <ol class="jobs-list">
        {jobNotes.map((j, i) => (
          <li data-reveal style={`--i:${i + 1}`}>
            <h3>{j.title}</h3>
            <p class="muted">{j.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .jobs-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }

  .jobs-media { position: relative; padding-bottom: 3.5rem; padding-right: 2.5rem; }
  .jobs-media figure { margin: 0; overflow: hidden; border-radius: var(--r-card); }
  .jobs-main { aspect-ratio: 16 / 11; box-shadow: var(--shadow-md); }
  .jobs-main :global(img), .jobs-side :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .jobs-side {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(150px, 34%, 230px);
    aspect-ratio: 3 / 4;
    border: 6px solid var(--paper);
    box-shadow: var(--shadow-md);
  }

  .jobs-copy { display: grid; gap: 1.75rem; }
  .jobs-list { list-style: none; padding: 0; display: grid; }
  .jobs-list li { display: grid; gap: 0.45rem; padding-block: 1.3rem; border-top: 2px solid var(--line); }
  .jobs-list li:first-child { border-top-color: var(--pink); }
  .jobs-list h3 { font-size: clamp(1.2rem, 1.8vw, 1.45rem); }
  .jobs-list p { max-width: 54ch; }

  @media (max-width: 900px) {
    .jobs-grid { grid-template-columns: 1fr; }
    .jobs-copy { order: -1; }
  }
</style>
