---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import bg from '@/assets/gen/hero-vermont.jpg';
import before from '@/assets/img/tub-before.jpg';
import after from '@/assets/img/tub-after.jpg';
import logo from '@/assets/brand/logo-light.png';
import { company, cta } from '@/data/business';
---

<section class="hero">
  <Image
    class="hero-bg"
    src={bg}
    alt=""
    widths={[640, 960, 1280, 1920, 2560, 3168]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <Image class="hero-logo" src={logo} alt={company.name} widths={[300, 600]} sizes="300px" loading="eager" />
      <h1>
        <span class="l">Done carefully.</span>
        <span class="l">Done completely.</span>
        <span class="l l-k">Done K<sup>2</sup>.</span>
      </h1>
      <p class="lede">
        Family-owned, fully insured house cleaning for Brattleboro and Southern Vermont.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/quote/">{cta.primary} <Icon name="arrow-right" class="arrow" /></a>
        <a class="btn btn-ghost hero-call" href={`tel:${company.phoneRaw}`} data-track="call-hero"><Icon name="phone" />{company.phone}</a>
      </div>
    </div>

    <figure class="hero-media">
      <div class="arch" data-ba>
        <Image class="arch-img" src={after} alt="A real Fortis K² job: the bathtub after cleaning, bright white" widths={[360, 546]} sizes="(max-width: 900px) 70vw, 420px" loading="eager" />
        <div class="arch-before">
          <Image class="arch-img" src={before} alt="The same bathtub before cleaning, stained yellow and brown" widths={[360, 546]} sizes="(max-width: 900px) 70vw, 420px" loading="eager" />
        </div>
        <span class="arch-line" aria-hidden="true"><span class="arch-knob"><Icon name="caret-left" /><Icon name="caret-right" /></span></span>
        <input class="arch-range" type="range" min="0" max="100" value="50" aria-label="Drag to compare before and after" data-ba-range />
      </div>
      <figcaption>
        <span class="tag tag-b">Before</span>
        <span><span class="cap-long">A real Fortis K² job. </span>Drag to compare.</span>
        <span class="tag tag-a">After</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(calc(100dvh - 76px), 860px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #bcdcf1;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 100%;
    z-index: -2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(252 251 253 / 0.62) 0%, rgb(252 251 253 / 0.3) 42%, rgb(252 251 253 / 0) 62%),
      linear-gradient(180deg, rgb(252 251 253 / 0.25) 0%, rgb(252 251 253 / 0) 55%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4rem);
  }

  .hero-copy { display: grid; gap: 1.2rem; justify-items: start; min-width: 0; }
  .hero-copy :global(.hero-logo) { width: clamp(210px, 21vw, 280px); height: auto; filter: drop-shadow(0 6px 18px rgb(255 255 255 / 0.7)); }
  h1 { font-size: clamp(2.6rem, 5vw, 4.5rem); font-variation-settings: 'wdth' 66; text-shadow: 0 2px 24px rgb(255 255 255 / 0.55); }
  h1 .l { display: block; white-space: nowrap; }
  h1 .l-k { color: var(--navy); }
  h1 sup { font-size: 0.5em; vertical-align: 0.9em; line-height: 0; color: var(--pink-ink); margin-left: 0.02em; }
  .lede { color: var(--ink); font-weight: 500; max-width: 38ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.2rem; }
  .hero .btn-ghost { background: rgb(255 255 255 / 0.75); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .hero .btn-ghost:hover { background: var(--ink); }

  /* ---- arch before/after */
  .hero-media { margin: 0; justify-self: end; width: 100%; max-width: 420px; display: grid; gap: 1.1rem; }
  .arch {
    --pos: 50%;
    position: relative;
    isolation: isolate;
    aspect-ratio: 546 / 605;
    border-radius: 999px 999px var(--r-card) var(--r-card);
    border: 6px solid #fff;
    overflow: hidden;
    background: var(--mist);
    box-shadow: 18px 18px 0 0 var(--pink), 0 30px 60px -30px rgb(11 30 69 / 0.6);
    touch-action: pan-y;
    user-select: none;
  }
  .arch :global(.arch-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .arch-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .arch-line { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 4px; translate: -50% 0; background: #fff; pointer-events: none; }
  .arch-knob {
    position: absolute;
    top: 58%;
    left: 50%;
    translate: -50% -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    box-shadow: var(--shadow-md);
  }
  .arch-knob :global(svg) { width: 16px; height: 16px; margin-inline: -2px; }
  .arch-range { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; margin: 0; cursor: ew-resize; }
  .arch:focus-within { outline: 3px solid var(--pink-ink); outline-offset: 4px; }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.45rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-sm);
    font-size: 0.86rem;
    font-weight: 650;
    color: var(--ink-2);
    text-align: center;
  }
  .tag { flex: none; padding: 0.3rem 0.75rem; border-radius: var(--r-pill); font-weight: 800; font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .tag-b { background: var(--ink); color: #fff; }
  .tag-a { background: var(--pink); color: var(--ink); }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: rise 0.9s var(--ease) both; }
    .hero-copy > :nth-child(2) { animation-delay: 0.06s; }
    .hero-copy > :nth-child(3) { animation-delay: 0.14s; }
    .hero-copy > :nth-child(4) { animation-delay: 0.2s; }
    .hero-media { animation: rise 1s var(--ease) 0.15s both; }
    .hero :global(.hero-bg) { animation: settle 1.6s var(--ease) both; }
    @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
    @keyframes settle { from { transform: scale(1.06); } }
  }

  @media (max-width: 900px) {
    .hero { min-height: 0; align-items: flex-start; }
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-media { justify-self: center; max-width: 320px; margin-right: 14px; }
    .arch { box-shadow: 12px 12px 0 0 var(--pink), 0 24px 50px -30px rgb(11 30 69 / 0.6); }
    .hero::after { background: linear-gradient(180deg, rgb(252 251 253 / 0.72) 0%, rgb(252 251 253 / 0.35) 40%, rgb(252 251 253 / 0) 60%); }
  }
  @media (max-width: 560px) {
    .hero-grid { padding-block: 1.75rem 2.25rem; }
    .hero-copy { gap: 1rem; }
    .hero-copy :global(.hero-logo) { display: none; }
    h1 { font-size: clamp(2.1rem, 10vw, 2.9rem); }
    .lede { font-size: 1.05rem; }
    .hero-cta { width: 100%; }
    .hero-cta .btn { width: 100%; }
    /* The sticky bottom bar already carries Call. */
    .hero-call { display: none; }
    .hero-media { max-width: 270px; }
    figcaption { font-size: 0.8rem; }
    .cap-long { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((stage) => {
    const range = stage.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!range) return;
    const set = () => stage.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>
