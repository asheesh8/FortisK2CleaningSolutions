---
import Icon from '@/components/Icon.astro';
import { process, cta } from '@/data/business';

const icons = ['chat-circle-text', 'house', 'clipboard-text', 'calendar-check'];
---

<section class="section proc">
  <div class="wrap">
    <div class="proc-head" data-reveal>
      <h2>Booking takes one message.</h2>
      <a class="btn" href="/quote/">{cta.primary} <Icon name="arrow-right" class="arrow" /></a>
    </div>

    <ol class="proc-line">
      {process.map((p, i) => (
        <li data-reveal style={`--i:${i}`}>
          <span class="proc-dot"><Icon name={icons[i]} /></span>
          <h3>{p.title}</h3>
          <p class="muted">{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proc-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .proc-head h2 { max-width: 16ch; }

  .proc-line { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; position: relative; }
  .proc-line::before {
    content: '';
    position: absolute;
    top: 30px;
    left: 30px;
    right: 12%;
    height: 3px;
    border-radius: 3px;
    background: repeating-linear-gradient(90deg, var(--navy) 0 14px, transparent 14px 24px);
    opacity: 0.35;
  }
  .proc-line li { position: relative; display: grid; gap: 0.6rem; align-content: start; }
  .proc-dot {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--ink);
    color: var(--ink);
    margin-bottom: 0.6rem;
    transition: background-color 0.3s, color 0.3s, transform 0.4s var(--ease);
  }
  .proc-line li:first-child .proc-dot { background: var(--pink); border-color: var(--pink); }
  .proc-line li:hover .proc-dot { transform: translateY(-4px); }
  .proc-dot :global(svg) { width: 26px; height: 26px; }
  .proc-line h3 { font-size: 1.35rem; }
  .proc-line p { max-width: 30ch; }

  @media (max-width: 900px) {
    .proc-line { grid-template-columns: 1fr 1fr; row-gap: 2.5rem; }
    .proc-line::before { display: none; }
  }
  @media (max-width: 560px) {
    .proc-line { grid-template-columns: 1fr; }
    .proc-line li { grid-template-columns: 62px 1fr; column-gap: 1rem; }
    .proc-dot { grid-row: span 2; margin: 0; }
  }
</style>
