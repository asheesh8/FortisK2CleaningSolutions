---
import Icon from '@/components/Icon.astro';
import { owners, story } from '@/data/business';

export interface Props {
  /** Full bios (About page) or one-liners (homepage). */
  full?: boolean;
}
const { full = false } = Astro.props;
---

<section class:list={['section own', full && 'own-full']}>
  <div class="wrap own-grid">
    <div class="own-copy" data-reveal>
      <p class="eyebrow">The women behind the clean</p>
      <h2>Three women. One family. <span class="pink">One shared vision.</span></h2>
      <p class="lede">{story}</p>
      {!full && <a class="text-link" href="/about/">Read our story <Icon name="arrow-right" /></a>}
    </div>

    <ul class="own-list" data-reveal style="--i:1">
      {owners.map((o, i) => (
        <li>
          {/* TODO(fortis): replace initials with real headshots when supplied. */}
          <span class:list={['own-mono', i === 1 && 'alt']} aria-hidden="true">{o.initials}</span>
          <div>
            <h3>{o.name}</h3>
            <p class="own-role">{o.role}</p>
            <p class="muted">{full ? o.bio : o.short}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .own { background: var(--mist); }
  .own-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .own-full .own-grid { align-items: start; }
  .own-copy { display: grid; gap: 1.2rem; justify-items: start; }

  .own-list { list-style: none; padding: 0; display: grid; border-radius: var(--r-card); background: var(--card); box-shadow: var(--shadow-sm); overflow: hidden; }
  .own-list li { display: grid; grid-template-columns: 64px 1fr; gap: 1.1rem; align-items: center; padding: 1.25rem 1.5rem; }
  .own-list li + li { border-top: 1px solid var(--line); }
  .own-full .own-list li { align-items: start; padding-block: 1.6rem; }
  .own-mono {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    font-weight: 900;
    font-size: 1.3rem;
    font-variation-settings: 'wdth' 75;
  }
  .own-mono.alt { background: var(--ink); color: #fff; }
  .own-list h3 { font-size: 1.25rem; }
  .own-role { font-weight: 700; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pink-ink); margin: 0.1rem 0 0.3rem; }
  .own-list .muted { font-size: 0.97rem; line-height: 1.45; }

  @media (max-width: 900px) {
    .own-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
  @media (max-width: 560px) {
    .own:not(.own-full) .lede { display: none; }
  }
  @media (max-width: 480px) {
    .own-list li { grid-template-columns: 48px 1fr; gap: 0.85rem; padding: 1rem; }
    .own-mono { width: 48px; height: 48px; font-size: 1rem; }
  }
</style>
