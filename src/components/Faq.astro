---
import Icon from '@/components/Icon.astro';
import { company } from '@/data/business';

export interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  id?: string;
}
const { items, heading = 'Questions, answered.', id = 'faq' } = Astro.props;
---

<section class="section faq" id={id}>
  <div class="wrap faq-grid">
    <div class="faq-side" data-reveal>
      <h2>{heading}</h2>
      <p class="muted">Anything else? Call or text <a href={`tel:${company.phoneRaw}`}>{company.phone}</a> or email <a href={`mailto:${company.email}`}>{company.email}</a>.</p>
    </div>

    <div class="faq-list">
      {items.map((f, i) => (
        <details data-reveal style={`--i:${i % 4}`} open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="faq-ic" aria-hidden="true"><Icon name="plus" /></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .faq-side { display: grid; gap: 1rem; position: sticky; top: 110px; }
  .faq-side a { color: var(--pink-ink); font-weight: 700; word-break: break-word; }

  .faq-list { display: grid; gap: 0.75rem; }
  details { border-radius: var(--r-card); background: var(--card); border: 1px solid var(--line); transition: border-color 0.25s, box-shadow 0.25s; }
  details[open] { border-color: var(--blush-2); box-shadow: var(--shadow-sm); }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    font-weight: 750;
    font-size: 1.1rem;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .faq-ic { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--blush); color: var(--pink-ink); transition: transform 0.35s var(--ease), background-color 0.2s; }
  .faq-ic :global(svg) { width: 16px; height: 16px; }
  details[open] .faq-ic { transform: rotate(45deg); background: var(--pink); color: var(--ink); }
  details p { padding: 0 1.4rem 1.3rem; color: var(--ink-2); max-width: 62ch; }

  @media (max-width: 860px) {
    .faq-grid { grid-template-columns: 1fr; }
    .faq-side { position: static; }
  }
</style>
