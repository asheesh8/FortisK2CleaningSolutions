---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { services } from '@/data/business';

export interface Props {
  heading?: string;
  /** Hide one service (used on its own page). */
  exclude?: string;
}
const { heading = 'Every kind of clean your home needs.', exclude } = Astro.props;
const list = services.filter((s) => s.slug !== exclude);
const isFull = list.length === 6;
---

<section class="section svc" id="services">
  <div class="wrap">
    <div class="svc-head" data-reveal>
      <h2>{heading}</h2>
      <p class="lede">One family-run team for regular upkeep, big resets, rentals and small businesses across Southern Vermont.</p>
    </div>

    <ul data-reveal class:list={['svc-grid', isFull && 'svc-grid-6', list.length === 5 && 'svc-grid-5']}>
      {list.map((s, i) => (
        <li class={`svc-cell c${i + 1}`}>
          <a href={`/services/${s.slug}/`} class="svc-card">
            <Image
              src={s.image}
              alt=""
              widths={[420, 640, 900, 1200]}
              sizes={i === 0 && isFull ? '(max-width: 760px) 92vw, 58vw' : '(max-width: 760px) 92vw, 36vw'}
            />
            <span class="svc-body">
              <span class="svc-title">{s.short}</span>
              <span class="svc-line">{s.line}</span>
              <span class="svc-go" aria-hidden="true"><Icon name="arrow-up-right" /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc-head { display: grid; gap: 1rem; max-width: 46rem; margin-bottom: clamp(2rem, 4vw, 3rem); }

  .svc-grid { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }
  .svc-grid-6 { grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(215px, auto); }
  .svc-grid-6 .c1 { grid-column: 1 / 8; grid-row: 1 / 3; }
  .svc-grid-6 .c2 { grid-column: 8 / 13; }
  .svc-grid-6 .c3 { grid-column: 8 / 13; }
  .svc-grid-6 .c4 { grid-column: 1 / 5; }
  .svc-grid-6 .c5 { grid-column: 5 / 9; }
  .svc-grid-6 .c6 { grid-column: 9 / 13; }

  .svc-grid-5 { grid-template-columns: repeat(6, 1fr); }
  .svc-grid-5 .c1, .svc-grid-5 .c2 { grid-column: span 3; min-height: 320px; }
  .svc-grid-5 .c3, .svc-grid-5 .c4, .svc-grid-5 .c5 { grid-column: span 2; }

  .svc-cell { min-height: 230px; }
  .svc-card {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--r-card);
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    isolation: isolate;
    background: var(--ink);
  }
  .svc-card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.9s var(--ease);
  }
  .svc-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(11 30 69 / 0) 38%, rgb(11 30 69 / 0.55) 62%, rgb(11 30 69 / 0.92) 100%);
  }
  .svc-card:hover :global(img) { transform: scale(1.045); }

  .svc-body { position: absolute; inset: auto 0 0 0; display: grid; gap: 0.3rem; padding: 1.4rem 4.5rem 1.4rem 1.5rem; }
  .svc-title { font-weight: 800; font-variation-settings: 'wdth' 80; font-size: clamp(1.35rem, 2vw, 1.7rem); line-height: 1.05; }
  .c1 .svc-title { font-size: clamp(1.7rem, 3vw, 2.5rem); }
  .svc-line { font-size: 0.98rem; line-height: 1.4; color: #e6eaf6; max-width: 34ch; }
  .svc-go {
    position: absolute;
    right: 1.2rem;
    bottom: 1.3rem;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    transition: transform 0.35s var(--ease);
  }
  .svc-go :global(svg) { width: 20px; height: 20px; }
  .svc-card:hover .svc-go { transform: rotate(45deg); }

  @media (max-width: 960px) {
    .svc-grid-6 { grid-template-columns: 1fr 1fr; grid-auto-rows: auto; }
    .svc-grid-6 .svc-cell { grid-column: auto; grid-row: auto; min-height: 300px; }
    .svc-grid-6 .c1 { grid-column: 1 / -1; min-height: 380px; }
    .svc-grid, .svc-grid-5 { grid-template-columns: 1fr 1fr; }
    .svc-grid-5 .svc-cell { grid-column: auto; }
    .svc-grid-5 .c1 { grid-column: 1 / -1; }
  }
  /* Phones: one swipeable row instead of six stacked cards. */
  @media (max-width: 700px) {
    .svc-grid, .svc-grid-6, .svc-grid-5 {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(-1 * var(--gutter));
      padding: 0.25rem var(--gutter) 0.75rem;
      scrollbar-width: none;
    }
    .svc-grid::-webkit-scrollbar { display: none; }
    .svc-grid .svc-cell, .svc-grid-6 .svc-cell, .svc-grid-6 .c1, .svc-grid-5 .svc-cell {
      flex: 0 0 82%;
      min-height: 330px;
      scroll-snap-align: start;
    }
    .svc-head { margin-bottom: 1.5rem; }
  }
</style>
