---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import before from '@/assets/img/tub-before.jpg';
import after from '@/assets/img/tub-after.jpg';
---

<section class="section ba" id="work">
  <div class="wrap ba-grid">
    <div class="ba-stage" data-ba data-reveal>
      <Image class="ba-img" src={after} alt="The same bathtub after cleaning: bright white and spotless" widths={[360, 546]} sizes="(max-width: 860px) 80vw, 420px" />
      <div class="ba-before" data-ba-before>
        <Image class="ba-img" src={before} alt="A bathtub before cleaning, stained yellow and brown across the floor" widths={[360, 546]} sizes="(max-width: 860px) 80vw, 420px" />
      </div>
      <span class="ba-tag ba-tag-b" aria-hidden="true">Before</span>
      <span class="ba-tag ba-tag-a" aria-hidden="true">After</span>
      <span class="ba-handle" aria-hidden="true"><span class="ba-knob"><Icon name="caret-left" /><Icon name="caret-right" /></span></span>
      <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Drag to compare before and after" data-ba-range />
    </div>

    <div class="ba-copy" data-reveal style="--i:1">
      <h2>Got a tub you dread scrubbing? <span class="pink">Let us handle it.</span></h2>
      <p class="lede">
        This is a real tub from a real Fortis K² job. Instead of spending your free time on your hands and knees, go grab a coffee,
        run errands or put your feet up. We will put in the elbow grease.
      </p>
      <a class="text-link" href="/services/deep-cleaning/">See what a deep clean covers <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .ba { background: var(--blush); }
  .ba-grid { display: grid; grid-template-columns: minmax(0, 460px) 1fr; gap: clamp(2rem, 6vw, 5.5rem); align-items: center; }
  .ba-copy { display: grid; gap: 1.3rem; justify-items: start; max-width: 36rem; }

  .ba-stage {
    --pos: 50%;
    position: relative;
    aspect-ratio: 546 / 605;
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: -16px 16px 0 0 var(--ink), var(--shadow-md);
    user-select: none;
    touch-action: pan-y;
  }
  .ba-stage :global(.ba-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }

  .ba-tag {
    position: absolute;
    top: 1rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--r-pill);
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .ba-tag-b { left: 1rem; background: var(--ink); color: #fff; }
  .ba-tag-a { right: 1rem; background: var(--pink); color: var(--ink); }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 4px;
    translate: -50% 0;
    background: #fff;
    pointer-events: none;
  }
  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    box-shadow: var(--shadow-md);
  }
  .ba-knob :global(svg) { width: 17px; height: 17px; margin-inline: -2px; }

  .ba-range { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; }
  .ba-stage:focus-within { outline: 3px solid var(--pink-ink); outline-offset: 4px; }

  @media (max-width: 860px) {
    .ba-grid { grid-template-columns: 1fr; }
    .ba-stage { max-width: 420px; width: calc(100% - 16px); justify-self: end; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((stage) => {
    const range = stage.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!range) return;
    const set = () => stage.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>
